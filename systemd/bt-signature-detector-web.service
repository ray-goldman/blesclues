[Unit]
Description=Bluetooth Signature Detector local web interface
After=NetworkManager.service bt-signature-detector-ap.service
Wants=bt-signature-detector-ap.service

[Service]
Type=simple
User=bt-web
Group=bt-detector
SupplementaryGroups=bt-detector
WorkingDirectory=/var/lib/bt-signature-detector
ExecStart=/opt/bt-signature-detector/active/bin/python -m bt_signature_detector.web --config /etc/bt-signature-detector/detector.yaml
Restart=on-failure
RestartSec=5
NoNewPrivileges=false
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
RuntimeDirectory=bt-signature-detector
RuntimeDirectoryMode=0770
RuntimeDirectoryGroup=bt-detector
RuntimeDirectoryPreserve=yes
ReadOnlyPaths=/run/bt-signature-detector
ReadWritePaths=/var/lib/bt-signature-detector /etc/bt-signature-detector
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
