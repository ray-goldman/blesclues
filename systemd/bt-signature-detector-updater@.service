[Unit]
Description=Apply verified BLE Detector release %i

[Service]
Type=oneshot
User=root
ExecStart=/opt/bt-signature-detector/active/bin/python -m bt_signature_detector.updater_service apply --id %i
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/bt-signature-detector /var/lib/bt-signature-detector /etc/systemd/system /etc/sudoers.d /usr/local/sbin
StandardOutput=journal
StandardError=journal
