[Unit]
Description=Local DHCP for BLE Detector access point
After=bt-signature-detector-ap.service
Requires=bt-signature-detector-ap.service

[Service]
Type=simple
ExecStart=/usr/sbin/dnsmasq --no-daemon --conf-file=/etc/bt-signature-detector/dnsmasq-ap.conf
Restart=on-failure
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
